# Copy to backend/.env or use repo root .env (load_dotenv() loads cwd)

# --- LLM / CrewAI ---
OPENAI_API_KEY=
# Optional explicit model for CrewAI when not using mock
OPENAI_MODEL=gpt-4o-mini
# CREW_MODEL=gpt-4o-mini

# --- Execution ---
# auto (default): mock if no OPENAI_API_KEY; true: always mock; false: require key + real crew
USE_MOCK_CREW=auto
CREW_MAX_RPM=10
CREW_MAX_ITER=12
CREW_VERBOSE=false

# --- Optional API hardening ---
# API_KEY=

# --- Telemetry ---
CREWAI_TELEMETRY_OPT_OUT=true
